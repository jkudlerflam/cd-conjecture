   X + Y
   X + YY
   X + YZ
   XX + XY
   XX + YY
   XY + XZ
   XY + YX
   X + Y + Z
   X + Y + ZZ
   X + YY + YZ
   X + YY + ZZ
   X + YZ + ZY
   XX + XY + XZ
   XX + XY + YX
   XX + XY + YY
   X + YY + YZ + ZY
   X + YY + YZ + ZZ
